{
  "name": "mentee",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "22.21.0",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm setup:backend",
    "setup:frontend": "pnpm install",
    "setup:backend": "cd backend && uv venv && uv pip install -r requirements.txt -r requirements-dev.txt",
    "dev": "pnpm -r --parallel run dev",
    "start": "pnpm dev",
    "local": "pnpm dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "start:frontend": "pnpm dev:frontend",
    "dev:backend": "pnpm --filter backend dev",
    "start:backend": "pnpm dev:backend",
    "build": "pnpm build:frontend",
    "build:frontend": "pnpm --filter frontend build",
    "heroku-postbuild": "pnpm build:frontend",
    "format": "pnpm -r --parallel run format:all",
    "format:backend": "pnpm --filter backend format:all"
  }
}
